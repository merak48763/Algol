use super::super::super::util::Callback

dispatch mcdoc:custom_data[spawner] to struct SpawnerCustomData {
  /// Labelling tags on the marker entity.
  /// In addition to the specified tags, all spawner markers have `al.spawner` tag.
  tags?: [#[tag] string],
  /// Command to run as & at the marker when the spawner is broken.
  on_broken?: Callback,
  /// Whether the marker should be kept after the spawner is broken.
  /// Defaults to `false`.
  no_gc?: boolean,
}
