use super::super::super::util::Callback

struct MacroParamMap {
  /// - `gu:convert`
  gu?: struct {
    UUID?: int[] @ 4,
  },
  /// - `algol.core:zzz/prepare_player/load_id`
  player_id?: struct {
    uuid_str?: #[uuid] string,
  },
  /// - `algol.core:zzz/player_storage/read`
  /// - `algol.core:zzz/player_storage/write`
  player_storage?: struct {
    player_id?: int @ 1..,
  },
  /// - `algol.drop:zzz/on_death/init_grave`
  position?: struct {
    x?: double,
    y?: double,
    z?: double,
  },
  /// - `algol.dialog:zzz/handle_input/load_command`
  dialog_button?: struct {
    id?: string,
    input?: int @ 1..,
  },
  /// - `algol.dialog:zzz/handle_form_input/load_and_run_command`
  dialog_form?: struct {
    id?: string,
  },
  /// - `algol.dialog:zzz/handle_input/eval`
  eval?: Callback,
}
