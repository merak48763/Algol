use super::super::util::ValueHolder
use super::super::util::Callback
use macro::MacroParamMap
use super::super::core::storage::PlayerStorage

dispatch minecraft:storage[algol:zzz] to struct AlgolInternalStorage {
  /// Macro parameters
  macro?: MacroParamMap,
  /// Serialized data
  ser?: SerializedData,
  /// Temp storage for data compare trick
  cmp?: any,
  /// Player string UUID → score ID
  player_id?: struct PlayerIdMap {
    [#[uuid] string]: int @ 1..,
  },
  /// Storage of each player
  player_storage?: struct PlayerStorageBase {
    [#[integer(min=1)] string]: PlayerStorage,
  },
}

struct SerializedData {
  /// UUID int array
  uuid?: int[] @ 4,
  /// `custom_data` component
  custom_data?: minecraft:data_component[custom_data],
}

dispatch minecraft:storage[gu:main] to struct GuStorage {
  /// GU internal data
  in?: int[] @ 4,
  /// GU output
  out?: #[uuid] string,
}
