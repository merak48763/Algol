struct MacroParamMap {
  [#[id="function"] string]: algol:macro_param[[%key]],
}

dispatch algol:macro_param[%unknown] to struct {
  [string]: any,
}

dispatch algol:macro_param[gu:convert] to struct {
  UUID?: int[] @ 4,
}

dispatch algol:macro_param[algol.core:zzz/prepare_player/load_id] to struct {
  uuid_str?: #[uuid] string,
}
