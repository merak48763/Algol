{
  "type": "sequence",
    "functions": [
    {
      "type": "copy_components",
      "source": "block_entity",
      "include": [
        "custom_data",
        "custom_name"
      ]
    },
    {
      "type": "filtered",
      "item_filter": {
        "predicates": {
          "custom_data": "{'al/discard_name': 1b}"
        }
      },
      "on_pass": {
        "type": "set_components",
        "components": {
          "!custom_data": {},
          "!custom_name": {}
        }
      }
    }
  ]
}
