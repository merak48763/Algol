struct MacroParamMap {
  /// - `gu:convert`
  gu?: struct {
    UUID?: int[] @ 4,
  },
  /// - `algol.core:zzz/prepare_player/load_id`
  player_id?: struct {
    uuid_str?: #[uuid] string,
  },
  /// - `algol.core:zzz/player_storage/read`
  /// - `algol.core:zzz/player_storage/write`
  player_storage?: struct {
    player_id?: int @ 1..,
  },
  /// - `algol.drop:zzz/on_death/init_grave`
  position?: struct {
    x?: double,
    y?: double,
    z?: double,
  },
}
